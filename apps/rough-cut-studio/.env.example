# Optional: pre-fill the Gemini API key on launch by setting this
# environment variable, instead of typing it into the app every time.
# Get a free key at https://aistudio.google.com/app/apikey
#
# Copy this file to `.env` and fill in your key, OR just paste the key
# into the app's "Gemini API Key" field each session (nothing is written
# to disk unless you tick "Remember key on this machine" in the app).
GEMINI_API_KEY=
