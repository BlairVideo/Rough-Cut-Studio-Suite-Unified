{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spyglass",
  "version": "0.1.0",
  "identifier": "edu.blair.spyglass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash packaging/build_sidecar_runtime.sh && bash packaging/build_ffmpeg_bin.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spyglass",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../packaging/build_staging/sidecar-runtime/": "sidecar-runtime/",
      "../packaging/build_staging/ffmpeg-bin/": "ffmpeg-bin/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    }
  }
}
