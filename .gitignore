# ---------------------------------------------------------------------------
# Python virtual environments — rebuilt locally via `uv sync`, never versioned.
# ---------------------------------------------------------------------------
**/.venv/
**/.venv-base/
**/.venv.bak*/
**/uv.lock.bak*

# ---------------------------------------------------------------------------
# Rust / Tauri build artifacts (card-eater, harmonizer)
# ---------------------------------------------------------------------------
**/src-tauri/target/
**/src-tauri/gen/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
**/node_modules/
**/dist/

# ---------------------------------------------------------------------------
# Python bytecode / test caches
# ---------------------------------------------------------------------------
**/__pycache__/
*.pyc
**/.pytest_cache/
**/.ruff_cache/

# ---------------------------------------------------------------------------
# Studio Suite's composed page — regenerated fresh at every launch (the
# original main.py's compose_page()), never hand-edited or versioned. See
# migration-plan.md §4 correction: this is a build output, not manually
# duplicated source.
# ---------------------------------------------------------------------------
apps/suite-wrapper/frontend/_generated/

# ---------------------------------------------------------------------------
# BRAW proxy tool — compiled locally against the proprietary Blackmagic RAW
# SDK, never vendored. Carried forward from the source repo's .gitignore.
# ---------------------------------------------------------------------------
apps/suite-wrapper/tools/braw/braw_proxy_tool
apps/suite-wrapper/tools/braw/test_av_settings

# ---------------------------------------------------------------------------
# Harmonizer's copy of the same proprietary Blackmagic RAW SDK that
# backend/align.py + backend/make_fcpxml.py's BRAW support uses — never
# vendored into the repo, same policy as the braw_proxy_tool entry above.
# ---------------------------------------------------------------------------
apps/harmonizer/backend/braw_sdk/

# ---------------------------------------------------------------------------
# Harmonizer manual-QA scratch output — regenerated on demand
# (make_test_audio.py writes ref.wav/take1-3.wav; align.py/make_fcpxml.py
# write real_test/report*.json + real_test/*.fcpxml), never hand-authored.
# real_test/placeholder_C024.mp4 is a real test fixture (used by
# suite-wrapper's test_harmonize_api.py) and stays tracked.
# ---------------------------------------------------------------------------
apps/harmonizer/backend/ref.wav
apps/harmonizer/backend/take1.wav
apps/harmonizer/backend/take2.wav
apps/harmonizer/backend/take3.wav
apps/harmonizer/backend/real_test/*.json
apps/harmonizer/backend/real_test/*.fcpxml
apps/harmonizer/backend/real_test/ref.wav
apps/harmonizer/backend/real_test/A001_*.wav

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
**/.DS_Store

# ---------------------------------------------------------------------------
# Secrets — never committed. API keys live in the system keychain, not in
# files; this guards against any future .env use. .env.example files
# (templates, no real secrets) are explicitly kept.
# ---------------------------------------------------------------------------
.env
**/.env
!**/.env.example

# ---------------------------------------------------------------------------
# Prebuilt app bundles / dist output — rebuilt on demand, not migrated.
# See migration-plan.md §6.5.
# ---------------------------------------------------------------------------
apps/suite-wrapper/Rough Cut Studio Suite.app/
apps/suite-wrapper/dist/
apps/card-eater/dist/

# ---------------------------------------------------------------------------
# Studio Suite's runtime user data — transcripts (may contain real student/
# staff names), favorites, imported logos. Generated by using the app, not
# source code; recreated automatically if missing. Never commit — see this
# repo's CLAUDE.md Security/Privacy mandate.
# ---------------------------------------------------------------------------
apps/suite-wrapper/assets/

# ---------------------------------------------------------------------------
# Claude Code local (personal) settings — machine-specific, not shared config.
# ---------------------------------------------------------------------------
**/.claude/settings.local.json

# ---------------------------------------------------------------------------
# Licensed commercial fonts (Blair Brander) — redistribution via git can
# violate the vendor's EULA. The free/open fonts in the same folder (EB
# Garamond, Bree Serif, Anton, Cinzel, Oswald, Poppins) are intentionally
# NOT excluded.
# ---------------------------------------------------------------------------
apps/blair-brander/fonts/AvenirNextLTPro-*.otf
apps/blair-brander/fonts/Avenir Next Condensed.ttc
apps/blair-brander/fonts/AGaramondPro-*.otf
apps/blair-brander/fonts/Haettenschweiler-Regular.ttf
